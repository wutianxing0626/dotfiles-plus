# dotfiles-plus zsh 通用配置（随仓库走）。
# 机器相关环境（conda / nvm / compinstall 路径等）请放 ~/.zshrc.local，见 zsh/zshrc.local.example。

# -- 基础（zsh-newuser-install 生成）--
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
bindkey -e

# -- 补全 --
autoload -Uz compinit
compinit

# -- oh-my-zsh --
ZSH_THEME="bashmix"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
export ZSH="$HOME/.oh-my-zsh"
CASE_SENSITIVE=true
source "$ZSH/oh-my-zsh.sh"

# -- 常用别名 --
alias ll='ls -Ahl'
export PATH="$HOME/.local/bin:$PATH"

# -- notify-done：nd() 跑完自动通知手机 --
nd() { notify-done "$@"; }

# -- tmrun：在分离 tmux 会话里跑长命令，输出写到日志；有 notify-done 则跑完自动通知 --
# 用法: tmrun <任务名> <命令...>
#   例: tmrun train python train.py --epochs 100
#       命令含分号时按参数传，引号由 tmrun 逐参数保护: tmrun train bash -c 'echo a; exit 1'
#       命令含管道时显式用 sh -c: tmrun train sh -c 'echo a | tee out.txt'
#   日志: $TMRUN_LOGDIR/<任务名>.log（默认 当前目录/logs）
tmrun() {
  if (( $# < 2 )); then
    cat >&2 <<'EOF'
用法: tmrun <任务名> <命令...>
  例: tmrun train python train.py --epochs 100
       tmrun train bash -c 'echo a; echo b; exit 1'
       tmrun train sh -c 'echo a | tee out.txt'
命令按参数传给 sh -c 执行；含分号时用 bash -c 包住，含管道/重定向时用 sh -c 包住。
日志默认写到 $TMRUN_LOGDIR/<任务名>.log（默认 当前目录/logs），可用 TMRUN_LOGDIR 改。
EOF
    return 1
  fi
  local name="$1"
  shift
  command -v tmux >/dev/null 2>&1 || { echo "tmrun: 需要 tmux（未安装或不在 PATH）" >&2; return 1; }
  if tmux has-session -t "$name" 2>/dev/null; then
    echo "tmrun: 会话 '$name' 已存在；换个名字，或先  tmux kill-session -t '$name'" >&2
    return 1
  fi
  local logdir="${TMRUN_LOGDIR:-$PWD/logs}"
  logdir="${logdir:A}"   # 归一化为绝对路径，避免相对路径在 tmux 会话里错位
  local log="$logdir/${name}.log"
  mkdir -p "$logdir"
  # 逐参数 %q 转义再拼接：保护内层引号/分号/管道，避免 sh -c 重新解释
  local cmd=""
  local a
  for a in "$@"; do
    cmd+="${(q)a} "
  done
  local runner="sh -c ${(qq)cmd}"
  local has_nd=0
  command -v notify-done >/dev/null 2>&1 && has_nd=1
  if (( has_nd )); then
    runner="notify-done --log-file ${(qq)log} $runner"
  fi
  if (( has_nd )); then
    tmux new -d -s "$name" "$runner"
  else
    tmux new -d -s "$name" "${runner} 2>&1 | tee ${(qq)log}"
  fi
  echo "tmrun: 会话 '$name' 已启动，日志: $log"
  echo "  查看: tail -f '$log'     附加: tmux attach -t '$name'"
}

# -- 机器相关配置（存在才加载，不随仓库走）--
[ -f "${ZDOTDIR:-$HOME}/.zshrc.local" ] && source "${ZDOTDIR:-$HOME}/.zshrc.local"

