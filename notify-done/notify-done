#!/usr/bin/env bash
# notify-done — 跑完命令后（无论成败）通过邮件或公司 IM 机器人通知手机
#
# 用法:
#   notify-done <命令及其参数...>
#   notify-done -- <命令...>          # 命令以 - 开头时用 --
#   notify-done --log-file 文件 <命令...>   # 无条件把命令输出写入该文件
#   notify-done --test                # 发一条测试通知（不跑命令）
#   notify-done --dry-run <命令...>   # 只打印将要发送的内容，不发
#   notify-done --retry <命令...>     # 失败后重试直到成功（默认最多 10 次，间隔 1 秒）
#   notify-done --retry-max 30 --retry-sleep 2 <命令...>  # 自定义上限与间隔；0 = 无限
#
# 配置: ~/.config/notify-done.conf（模板见 notify-done.conf.example）
# 通道: 邮件（mail，推荐）或群机器人 webhook（webhook，支持企业微信/钉钉/飞书）
set -uo pipefail

CONF_FILE="${NOTIFY_DONE_CONFIG:-$HOME/.config/notify-done.conf}"

# ---- 默认值 ----
NOTIFY_BACKEND="${NOTIFY_BACKEND:-webhook}"
NOTIFY_TITLE_PREFIX="$(hostname 2>/dev/null || echo server)"
# 日志捕获：>0 时把命令的输出 tee 到文件，失败时附上末尾若干行；0 = 关闭（默认）
NOTIFY_LOG_LINES="${NOTIFY_LOG_LINES:-0}"
NOTIFY_LOG_ON_ALL="${NOTIFY_LOG_ON_ALL:-0}"
NOTIFY_LOG_DIR="${NOTIFY_LOG_DIR:-$HOME/.cache/notify-done}"
# 重试默认值（conf 可覆盖；仅当命令行显式传 --retry* 参数时才启用重试）
NOTIFY_RETRY_MAX="${NOTIFY_RETRY_MAX:-10}"
NOTIFY_RETRY_SLEEP="${NOTIFY_RETRY_SLEEP:-1}"

if [[ -f "$CONF_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONF_FILE"
fi

usage() {
  cat >&2 <<'EOF'
用法: notify-done [--log-file 文件] [--retry [--retry-max N] [--retry-sleep S]]
                 [--test | --dry-run] [--] <命令及其参数...>

示例:
  notify-done python train.py
  notify-done --log-file /tmp/run.log python train.py
  notify-done --retry python train.py
  notify-done --retry-max 30 --retry-sleep 2 python train.py
  notify-done --retry-max 0 --retry-sleep 0.1 sh -c 'ping -c1 host'
  notify-done --test
  notify-done --dry-run sh -c 'exit 3'

--retry:            失败后按间隔重试，直到成功或达到上限
--retry-max N:      含首次的总尝试次数；0 = 无限（默认 10）
--retry-sleep S:    两次尝试的间隔秒数，支持小数如 0.1（默认 1）
--log-file 文件: 无条件把命令输出写入该文件（不受 NOTIFY_LOG_LINES 开关影响）

--retry / --retry-max / --retry-sleep 任一出现即启用重试；
NOTIFY_RETRY_MAX / NOTIFY_RETRY_SLEEP 可改默认值（conf 或环境变量），但不单独启用重试。

配置: 编辑 ~/.config/notify-done.conf（模板见 notify-done.conf.example）
EOF
  exit 2
}

TEST_MODE=0
DRY_RUN=0
LOG_FILE_ARG=""
RETRY_MODE=0
RETRY_MAX=""
RETRY_SLEEP=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --test)    TEST_MODE=1; shift ;;
    --dry-run) DRY_RUN=1;   shift ;;
    --log-file)
      if [[ $# -lt 2 ]]; then
        echo "错误: --log-file 需要一个文件路径" >&2
        exit 2
      fi
      LOG_FILE_ARG="$2"
      shift 2
      ;;
    --retry)
      RETRY_MODE=1
      shift
      ;;
    --retry-max)
      if [[ $# -lt 2 ]]; then
        echo "错误: --retry-max 需要一个次数参数" >&2
        usage
      fi
      RETRY_MODE=1
      RETRY_MAX="$2"
      shift 2
      ;;
    --retry-sleep)
      if [[ $# -lt 2 ]]; then
        echo "错误: --retry-sleep 需要一个秒数参数" >&2
        usage
      fi
      RETRY_MODE=1
      RETRY_SLEEP="$2"
      shift 2
      ;;
    --)        shift; break ;;
    -h|--help) usage ;;
    *)         break ;;
  esac
done

# ---- 重试参数校验（模式由命令行显式开启；conf/env 只提供默认值）----
if [[ $RETRY_MODE -eq 1 ]]; then
  RETRY_MAX="${RETRY_MAX:-${NOTIFY_RETRY_MAX:-10}}"
  RETRY_SLEEP="${RETRY_SLEEP:-${NOTIFY_RETRY_SLEEP:-1}}"
  if ! [[ "$RETRY_MAX" =~ ^[0-9]+$ ]]; then
    echo "错误: --retry-max 需要非负整数（0 = 无限），实际为: '$RETRY_MAX'" >&2
    usage
  fi
  if ! [[ "$RETRY_SLEEP" =~ ^[0-9]+(\.[0-9]+)?$ ]] || [[ "$RETRY_SLEEP" =~ ^0+(\.0+)?$ ]]; then
    echo "错误: --retry-sleep 需要大于 0 的秒数（可小数，如 0.1），实际为: '$RETRY_SLEEP'" >&2
    usage
  fi
fi

# 执行一次命令并捕获退出码；开了日志时第 1 次覆盖写、之后追加写
run_attempt() {
  local attempt="$1"
  shift
  if [[ -n "$LOG_FILE" ]]; then
    if [[ $attempt -eq 1 ]]; then
      "$@" 2>&1 | tee "$LOG_FILE"
    else
      "$@" 2>&1 | tee -a "$LOG_FILE"
    fi
    status=${PIPESTATUS[0]}
  else
    "$@"
    status=$?
  fi
  return "$status"
}

if [[ $TEST_MODE -eq 1 ]]; then
  RETRY_MODE=0
  cmd_str="(测试通知)"
  status=0
  start_ts="$(date +%s)"
  end_ts="$(date +%s)"
else
  if [[ $# -eq 0 ]]; then
    usage
  fi
  cmd_str="$*"
  start_ts="$(date +%s)"

  # ---- 日志目标：重试全程共用同一文件 ----
  LOG_FILE=""
  if [[ -n "$LOG_FILE_ARG" ]]; then
    mkdir -p "$(dirname "$LOG_FILE_ARG")"
    LOG_FILE="$LOG_FILE_ARG"
  elif [[ ${NOTIFY_LOG_LINES:-0} -gt 0 ]]; then
    mkdir -p "$NOTIFY_LOG_DIR"
    LOG_FILE="${NOTIFY_LOG_FILE:-$NOTIFY_LOG_DIR/notify-$(date '+%Y%m%d-%H%M%S')-$$.log}"
  fi

  # ---- 执行：重试模式（显式开启）或单次执行 ----
  attempts_total=0
  if [[ $RETRY_MODE -eq 1 ]]; then
    while :; do
      attempts_total=$((attempts_total + 1))
      run_attempt "$attempts_total" "$@"
      if [[ $status -eq 0 ]]; then
        break
      fi
      if [[ $RETRY_MAX -ne 0 && $attempts_total -ge $RETRY_MAX ]]; then
        echo "notify-done: 已达重试上限（${attempts_total} 次），最后一次退出码 ${status}，放弃" >&2
        break
      fi
      echo "notify-done: 第 ${attempts_total} 次尝试失败（退出码 ${status}），${RETRY_SLEEP} 秒后重试" >&2
      if [[ -n "$LOG_FILE" ]]; then
        printf '\n===== 第 %s 次尝试失败（退出码 %s），%s 秒后重试 =====\n' \
          "$attempts_total" "$status" "$RETRY_SLEEP" >> "$LOG_FILE"
      fi
      sleep "$RETRY_SLEEP"
    done
  else
    attempts_total=1
    run_attempt 1 "$@"
  fi
  end_ts="$(date +%s)"
fi

# ---- 耗时 ----
elapsed=$((end_ts - start_ts))
if (( elapsed < 60 )); then
  elapsed_str="${elapsed} 秒"
elif (( elapsed < 3600 )); then
  elapsed_str="$((elapsed / 60)) 分 $((elapsed % 60)) 秒"
else
  elapsed_str="$((elapsed / 3600)) 小时 $(((elapsed % 3600) / 60)) 分"
fi

# ---- 命令描述截断 ----
if [[ ${#cmd_str} -gt 120 ]]; then
  cmd_str="${cmd_str:0:120}…"
fi

now="$(date '+%Y-%m-%d %H:%M:%S')"

if [[ $status -eq 0 ]]; then
  result="成功"
  subject="[成功] ${NOTIFY_TITLE_PREFIX}: ${cmd_str}"
else
  result="失败（退出码 ${status}）"
  subject="[失败 ${status}] ${NOTIFY_TITLE_PREFIX}: ${cmd_str}"
fi

body="主机: $(hostname 2>/dev/null || echo unknown)
命令: ${cmd_str}
状态: ${result}
耗时: ${elapsed_str}
时间: ${now}"

if [[ $RETRY_MODE -eq 1 ]]; then
  body+="
尝试次数: ${attempts_total}"
  if [[ $status -ne 0 && $RETRY_MAX -ne 0 ]]; then
    body+="
已重试至上限（${RETRY_MAX} 次）"
  fi
fi

# 需要日志时，把命令输出末尾若干行 / 完整日志路径附加到通知里
if [[ -n "${LOG_FILE:-}" && ${NOTIFY_LOG_LINES:-0} -gt 0 && ( $status -ne 0 || ${NOTIFY_LOG_ON_ALL:-0} -eq 1 ) ]]; then
  local_tail="$(tail -n "$NOTIFY_LOG_LINES" "$LOG_FILE" 2>/dev/null | python3 -c 'import sys,re;print(re.sub(r"\x1b\[[0-9;]*[A-Za-z]","",sys.stdin.read()))')"
  if [[ ${#local_tail} -gt 4000 ]]; then
    local_tail="…(过长已截断，完整见日志文件)…${local_tail: -3900}"
  fi
  body+="
日志尾部（${NOTIFY_LOG_LINES} 行）:
${local_tail}
完整日志: ${LOG_FILE}"
fi

# ---- 发送后端：邮件 ----
send_mail() {
  local subject="$1" body="$2"
  local need=(SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASS MAIL_FROM MAIL_TO)
  local v
  for v in "${need[@]}"; do
    if [[ -z "${!v:-}" ]]; then
      echo "错误: 未配置 ${v}，请编辑 ${CONF_FILE}" >&2
      return 1
    fi
  done
  python3 - "$subject" "$body" "$SMTP_HOST" "$SMTP_PORT" \
    "$SMTP_USER" "$SMTP_PASS" "$MAIL_FROM" "$MAIL_TO" <<'PY'
import smtplib, sys
from email.message import EmailMessage

subject, body, host, port_s, user, pwd, from_, to = sys.argv[1:]
port = int(port_s)

msg = EmailMessage()
msg["From"] = from_
msg["To"] = to
msg["Subject"] = subject
msg.set_content(body)

if port == 465:
    server = smtplib.SMTP_SSL(host, port, timeout=20)
else:
    server = smtplib.SMTP(host, port, timeout=20)
    server.ehlo()
    server.starttls()
    server.ehlo()
try:
    server.login(user, pwd)
    server.send_message(msg)
finally:
    server.quit()
PY
}

# ---- 发送后端：群机器人 webhook（企业微信/钉钉/飞书）----
send_webhook() {
  local text="$1"
  if [[ -z "${WEBHOOK_URL:-}" ]]; then
    echo "错误: 未配置 WEBHOOK_URL，请编辑 ${CONF_FILE}" >&2
    return 1
  fi
  local msg_type="${WEBHOOK_MSG_TYPE:-wecom}"
  local payload
  # 用 python3 生成 JSON，避免对 jq 的强依赖（json.dumps 会正确转义换行/引号/特殊字符）
  payload="$(python3 - "$msg_type" "$text" "${FEISHU_AT_USERS:-}" "${FEISHU_AT_ALL:-0}" <<'PY'
import json, sys
msg_type, text, at_users, at_all = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
text = text.rstrip("\n")
if msg_type == "feishu":
    # 飞书 text 消息用 <at> 标签 @ 人：@ 指定用户填群成员的 open_id（ou_ 开头），
    # @ 所有人填 all。被 @ 的用户即使群消息静音，手机端也能收到推送。
    if at_all.strip() == "1":
        text += "\n<at user_id=\"all\"></at>"
    for uid in (u.strip() for u in at_users.split(",") if u.strip()):
        text += "\n<at user_id=\"" + uid + "\"></at>"
    print(json.dumps({"msg_type": "text", "content": {"text": text}}))
else:
    # 企业微信 / 钉钉 使用相同的载荷结构
    print(json.dumps({"msgtype": "text", "text": {"content": text}}))
PY
)"
  curl -fsS -m 15 -H 'Content-Type: application/json' -d "$payload" "$WEBHOOK_URL"
}

send_notification() {
  case "$NOTIFY_BACKEND" in
    mail)    send_mail "$subject" "$body" ;;
    webhook) send_webhook "$(printf '%s\n%s' "$subject" "$body")" ;;
    *)
      echo "错误: 未知 NOTIFY_BACKEND='${NOTIFY_BACKEND}'（可选 mail / webhook）" >&2
      return 1
      ;;
  esac
}

# ---- dry-run：只打印不发 ----
if [[ $DRY_RUN -eq 1 ]]; then
  echo "== dry-run：以下内容不会实际发送 =="
  echo "backend: ${NOTIFY_BACKEND}"
  if [[ $RETRY_MODE -eq 1 ]]; then
    echo "retry: 上限 ${RETRY_MAX} 次（0 = 无限），间隔 ${RETRY_SLEEP} 秒"
  fi
  echo "subject: ${subject}"
  echo "body:"
  echo "${body}"
  if [[ "${WEBHOOK_MSG_TYPE:-wecom}" == "feishu" ]]; then
    echo "feishu @用户: ${FEISHU_AT_USERS:-（未配置）}"
    echo "feishu @所有人: ${FEISHU_AT_ALL:-0}"
  fi
  exit "$status"
fi

# ---- 发送 ----
send_notification
send_rc=$?
if [[ $send_rc -ne 0 ]]; then
  echo "警告: 通知发送失败（命令本身已结束）" >&2
fi

if [[ $TEST_MODE -eq 1 ]]; then
  exit "$send_rc"
fi
exit "$status"
